MILENA_KAFKA_INTEGRATION=1
MILENA_KAFKA_BROKERS=localhost:19092
MILENA_KAFKA_ENVIRONMENT=local-issue14
MILENA_KAFKA_TOPIC=milena.issue14.records
MILENA_KAFKA_USERNAME=milena_plain
MILENA_KAFKA_PASSWORD=milena-plain-secret
MILENA_KAFKA_SASL_MECHANISM=PLAIN
# Set when the local SASL_SSL broker uses a generated CA.
# MILENA_KAFKA_SSL_CA_LOCATION=docker/kafka/generated/ssl/ca.crt
# Set to an empty value if the local certificate does not include a localhost SAN.
# MILENA_KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=
MILENA_KAFKA_UNAVAILABLE_BROKERS=127.0.0.1:1
